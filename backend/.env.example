# ====== Servidor ======
PORT=8080
# URL(s) del frontend permitidas por CORS (separadas por coma)
CORS_ORIGIN=http://localhost:5173

# ====== Base de datos MySQL ======
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=bd_farmacia
# true en la nube (Aiven, etc.) que exige conexión SSL
DB_SSL=false

# ====== JWT ======
# Cambia esto por una cadena larga y aleatoria
JWT_SECRET=cambia-esta-clave-secreta-por-una-larga
JWT_EXPIRES_IN=86400
